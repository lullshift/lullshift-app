{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullshift:engine:quiz:v1:data",
  "title": "Quick Quiz pack (lullshift.quiz@1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "questions"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
    },
    "shuffle": {
      "type": "boolean"
    },
    "roundSize": {
      "description": "Optional: questions per round, drawn from the pack and preferring ones not asked in recent rounds. Should be at most the number of questions; the engine treats a larger value as the whole pack.",
      "type": "integer",
      "minimum": 3,
      "maximum": 40
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "choices", "answer", "explanation"],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "image": {
            "description": "Optional picture shown above the question: a path the pack's manifest lists in images, and alt text that gives the same information as the picture.",
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^images/[a-z0-9][a-z0-9-]{0,63}\\.(?:png|webp)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
              }
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "choices": {
                  "type": "array",
                  "maxItems": 2
                }
              },
              "required": ["choices"]
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "maximum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "choices": {
                  "type": "array",
                  "maxItems": 3
                }
              },
              "required": ["choices"]
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "maximum": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "choices": {
                  "type": "array",
                  "maxItems": 4
                }
              },
              "required": ["choices"]
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "maximum": 3
                }
              }
            }
          }
        ]
      }
    }
  }
}
