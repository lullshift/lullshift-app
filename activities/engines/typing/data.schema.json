{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullshift:engine:typing:v1:data",
  "title": "Typing Drills pack (lullshift.typing@1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "lines"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F­؜᠎​-‏‪-‮⁠-⁤⁦-⁯﻿]*$"
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F­؜᠎​-‏‪-‮⁠-⁤⁦-⁯﻿]*$"
    },
    "mode": {
      "type": "string",
      "enum": ["accuracy", "flow"]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[ -~]*$"
      }
    }
  }
}
