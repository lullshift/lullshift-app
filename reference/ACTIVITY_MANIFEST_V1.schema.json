{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lullshift Activity Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "category",
    "entrypoint",
    "runtime",
    "minHostVersion",
    "sdkVersion",
    "permissions",
    "interruptibility",
    "offline"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "enum": [
        "arcade",
        "break",
        "productivity",
        "interactive"
      ]
    },
    "entrypoint": {
      "const": "index.html"
    },
    "runtime": {
      "const": "isolated-web-v1"
    },
    "minHostVersion": {
      "type": "string"
    },
    "sdkVersion": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "activity.storage"
        ]
      }
    },
    "interruptibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pause",
        "resume",
        "persistState"
      ],
      "properties": {
        "pause": {
          "const": true
        },
        "resume": {
          "const": true
        },
        "persistState": {
          "const": true
        }
      }
    },
    "offline": {
      "type": "boolean"
    }
  }
}
