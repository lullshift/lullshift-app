{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullshift:schema:marketplace:v1",
  "title": "Lullshift Marketplace Index v1",
  "description": ".lullshift/marketplace.json at the root of a Git repository that acts as a Lullshift marketplace (ADR-002). Each entry points to an activity folder containing manifest.json, either in this repository or in another Git repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "activities"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "description": "Short marketplace name shown in the UI and used in commands. 'lullshift' is reserved for the built-in marketplace.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(?![\\s\\S]*[\\u0300-\\u036F\\u0483-\\u0489\\u0591-\\u05BD\\u0610-\\u061A\\u064B-\\u065F\\u1AB0-\\u1AFF\\u1DC0-\\u1DFF\\u20D0-\\u20FF\\uFE20-\\uFE2F]{5})[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
    },
    "owner": {
      "description": "Self-declared, unverified. Plain text.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?![\\s\\S]*[\\u0300-\\u036F\\u0483-\\u0489\\u0591-\\u05BD\\u0610-\\u061A\\u064B-\\u065F\\u1AB0-\\u1AFF\\u1DC0-\\u1DFF\\u20D0-\\u20FF\\uFE20-\\uFE2F]{5})[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\u3164\\uFEFF\\uFFA0\\uFFF9-\\uFFFB\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E007F}]*$"
    },
    "activities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "description": "A `/`-separated path of at most 12 parts. Each part starts with a letter, digit or underscore (so no empty, `.`, `..`, `.git` or leading `-`), has at most 64 characters from letters, digits, `.`, `_`, `-`, does not end with `.`, and is not a Windows reserved device name (CON, PRN, AUX, NUL, COM1-9, LPT1-9, with or without an extension). Enforced again by the Rust marketplace crate.",
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[A-Za-z0-9_](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[A-Za-z0-9_](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?){0,11}$",
      "maxLength": 300
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {
          "description": "Must equal the id in the referenced manifest.json.",
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
          "maxLength": 160
        },
        "source": {
          "oneOf": [
            {
              "description": "Folder in this repository.",
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {
                  "$ref": "#/$defs/relativePath"
                }
              }
            },
            {
              "description": "Folder in another Git repository. 'ref' is a tag, branch or commit; the installed version is always pinned to the resolved commit SHA.",
              "type": "object",
              "additionalProperties": false,
              "required": ["git"],
              "properties": {
                "git": {
                  "description": "https://host/path, ssh://[user@]host[:port]/path, git@host:path or GitHub shorthand owner/repo. No userinfo (https allows none; ssh allows a user name only, never a password), no option-looking host, owner or path part, no `..` or `.git` path part (a final `repo.git` is fine), no control characters or whitespace, and no localhost, IP literal or local-network host name.",
                  "type": "string",
                  "pattern": "^(?:https://(?![A-Za-z0-9.-]*\\.(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|[Ll][Oo][Cc][Aa][Ll]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll]|[Ll][Aa][Nn]|[Ll][Oo][Cc][Aa][Ll][Dd][Oo][Mm][Aa][Ii][Nn]|[Ii][Nn][Tt][Rr][Aa][Nn][Ee][Tt]|[Cc][Oo][Rr][Pp]|[Hh][Oo][Mm][Ee]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Aa][Rr][Pp][Aa])(?::|/|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z][A-Za-z0-9-]{0,61}[A-Za-z0-9](?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9_][A-Za-z0-9._-]{0,99}){1,10}|ssh://(?:[A-Za-z0-9][A-Za-z0-9._-]{0,31}@)?(?![A-Za-z0-9.-]*\\.(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|[Ll][Oo][Cc][Aa][Ll]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll]|[Ll][Aa][Nn]|[Ll][Oo][Cc][Aa][Ll][Dd][Oo][Mm][Aa][Ii][Nn]|[Ii][Nn][Tt][Rr][Aa][Nn][Ee][Tt]|[Cc][Oo][Rr][Pp]|[Hh][Oo][Mm][Ee]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Aa][Rr][Pp][Aa])(?::|/|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z][A-Za-z0-9-]{0,61}[A-Za-z0-9](?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9_][A-Za-z0-9._-]{0,99}){1,10}|git@(?![A-Za-z0-9.-]*\\.(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|[Ll][Oo][Cc][Aa][Ll]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll]|[Ll][Aa][Nn]|[Ll][Oo][Cc][Aa][Ll][Dd][Oo][Mm][Aa][Ii][Nn]|[Ii][Nn][Tt][Rr][Aa][Nn][Ee][Tt]|[Cc][Oo][Rr][Pp]|[Hh][Oo][Mm][Ee]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Aa][Rr][Pp][Aa])(?::|/|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z][A-Za-z0-9-]{0,61}[A-Za-z0-9]:[A-Za-z0-9_][A-Za-z0-9._-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9._-]{0,99}){0,9}|[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_][A-Za-z0-9._-]{0,99})$",
                  "maxLength": 300
                },
                "ref": {
                  "$ref": "#/$defs/gitRef"
                },
                "path": {
                  "$ref": "#/$defs/relativePath"
                }
              }
            }
          ]
        },
        "featured": {
          "type": "boolean"
        }
      }
    },
    "gitRef": {
      "description": "A branch, tag or commit id. No leading '-', '..', '//', ':', '^', '~', '*', '?', '[', backslash, whitespace or '@{', no part starting with '.', no '.lock' suffix. At run time it must also pass `git check-ref-format --allow-onelevel`, or be a 40-hex commit id.",
      "type": "string",
      "pattern": "^(?!-)(?!/)(?!\\.)(?!.*\\.\\.)(?!.*//)(?!.*/$)(?!.*/\\.)(?!.*\\.$)(?!.*\\.lock(?:/|$))[A-Za-z0-9._/-]{1,200}$",
      "maxLength": 200
    }
  }
}
