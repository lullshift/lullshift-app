{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullshift:schema:agent-event:v1",
  "title": "Lullshift Agent Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "provider",
    "providerSessionId",
    "eventType",
    "timestampUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "description": "Lowercase hyphenated UUID.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider": {
      "type": "string",
      "description": "Lowercase provider slug, e.g. claude-code.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "providerSessionId": {
      "type": "string",
      "description": "Opaque provider session id. No control, bidi, zero-width or other invisible formatting characters.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF\\uFFF9-\\uFFFB]+$"
    },
    "eventType": {
      "enum": [
        "session_started",
        "working",
        "needs_attention",
        "turn_ended",
        "completed",
        "failed",
        "cancelled",
        "session_ended",
        "heartbeat"
      ]
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time",
      "description": "Strict RFC 3339: T separator, seconds 00-59, 1-9 fractional digits, Z or +HH:MM/-HH:MM.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "correlationId": {
      "type": "string",
      "description": "Opaque correlation id. No control, bidi, zero-width or other invisible formatting characters.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF\\uFFF9-\\uFFFB]+$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Small, non-sensitive hints only. Scalar values; never prompts, code or task content.",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF\\uFFF9-\\uFFFB]*$"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
