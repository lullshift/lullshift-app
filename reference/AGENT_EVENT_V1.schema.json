{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullshift:schema:agent-event:v1",
  "title": "Lullshift Agent Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "provider",
    "providerSessionId",
    "eventType",
    "timestampUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "description": "Lowercase hyphenated UUID.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "providerSessionId": {
      "type": "string",
      "maxLength": 256
    },
    "eventType": {
      "enum": [
        "session_started",
        "working",
        "needs_attention",
        "turn_ended",
        "completed",
        "failed",
        "cancelled",
        "heartbeat"
      ]
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time",
      "description": "Strict RFC 3339: T separator, seconds 00-59, 1-9 fractional digits, Z or +HH:MM/-HH:MM.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "correlationId": {
      "type": "string",
      "maxLength": 256
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "metadata": {
      "type": "object",
      "maxProperties": 20
    }
  }
}
