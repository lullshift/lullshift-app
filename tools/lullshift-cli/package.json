{
  "name": "@lullshift/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "The Lullshift creator CLI: create, dev, simulate, validate, pack and marketplace init (ADR-017). Works offline, no account.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lullshift/lullshift-app.git",
    "directory": "tools/lullshift-cli"
  },
  "type": "module",
  "bin": {
    "lullshift": "./src/main.ts"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "lullshift": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/npm-build.mjs",
    "prepack": "node ../../scripts/npm-build.mjs",
    "prepublishOnly": "node ../../scripts/npm-publish-guard.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lullshift/activity-sdk": "workspace:*",
    "@lullshift/agent-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
