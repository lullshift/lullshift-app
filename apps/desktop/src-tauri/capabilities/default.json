{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only what the UI uses. Add permissions deliberately, one per need.",
  "windows": ["main"],
  "permissions": [
    "allow-dashboard",
    "allow-claude-code-status",
    "allow-claude-code-install",
    "allow-claude-code-uninstall",
    "allow-notification-prefs",
    "allow-set-notification-prefs",
    "allow-activities-list",
    "allow-activity-info",
    "allow-activity-storage-get",
    "allow-activity-storage-set",
    "allow-activity-storage-remove",
    "allow-activity-snapshot",
    "allow-activity-save-snapshot",
    "allow-activity-clear-snapshot",
    "allow-activity-preview",
    "allow-activity-add-play",
    "allow-activity-content",
    "allow-session-detail",
    "allow-set-session-notes",
    "allow-set-session-intent",
    "allow-set-session-title",
    "allow-add-session-item",
    "allow-update-session-item",
    "allow-delete-session-item",
    "allow-move-session-item",
    "allow-link-sessions",
    "allow-unlink-sessions",
    "allow-mark-reviewed",
    "allow-clear-captured-context",
    "allow-clear-all-captured-context",
    "allow-export-session",
    "allow-delete-session",
    "allow-context-prefs",
    "allow-set-context-prefs",
    "allow-ui-prefs",
    "allow-set-ui-prefs",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
